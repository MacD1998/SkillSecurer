# Scegli UN provider (decommentane uno). Il provider è auto-rilevato dalla
# presenza della API key, oppure forzato con LLM_PROVIDER.

# Opzione A (testata): OpenRouter
OPENROUTER_API_KEY=sk-or-....
SECURITY_MODEL=deepseek/deepseek-v4-pro

# Opzione B: DeepSeek nativo
#DEEPSEEK_API_KEY=sk-....
#SECURITY_MODEL=deepseek-chat

# Opzione C: OpenAI
#OPENAI_API_KEY=sk-....
#SECURITY_MODEL=gpt-4o-mini

# Forza esplicitamente il provider (opzionale): deepseek | openrouter | openai
#LLM_PROVIDER=openrouter

# OpenRouter: routing per-richiesta verso l'endpoint più economico (Auto Min
# Price), sovrascrive il quality-first di default sulle chiamate con tool.
# Default "price". Valori: price | throughput | latency. "none"/vuoto → disabilita
# (lascia il routing di default di OpenRouter). Solo branch openrouter.
#OPENROUTER_PROVIDER_SORT=price

# OpenRouter: escludi endpoint specifici (comma-separated). Utile quando un
# provider ritorna content vuoto/reasoning-only o troncato: con sort=price
# attivo il routing sceglie il più economico TRA i rimanenti. Il nome del
# provider colpevole compare nel warning "[Blue] scan error ... provider=...".
#OPENROUTER_PROVIDER_IGNORE=StreamLake,Baidu

# OpenRouter: whitelist esclusiva di endpoint (comma-separated). Se impostata,
# il routing usa SOLO questi. Precede IGNORE. Es. per inchiodare al provider
# nativo più affidabile:
#OPENROUTER_PROVIDER_ONLY=DeepSeek

# Blue: numero di retry sullo scan/patch quando la risposta è inutilizzabile
# (vuota/reasoning-only). Default 2 (= 3 tentativi totali).
#BLUE_SCAN_RETRIES=2

# Pipeline blue-eval: modello del validator Tier-2 (giudizio sui casi ambigui).
# Per indipendenza dal modello sotto test, usane uno DIVERSO da SECURITY_MODEL.
# Se non impostato ricade su SECURITY_MODEL.
#VALIDATOR_MODEL=anthropic/claude-3.5-sonnet

# Override per-agente (tutti opzionali — se non impostati ricadono su
# SECURITY_MODEL). Selezionabili anche dalla WebUI, pannello "Model per agent"
# sotto il model picker principale.
#RED_MODEL=anthropic/claude-3.5-sonnet
#BLUE_SCAN_MODEL=anthropic/claude-3.5-sonnet
#BLUE_PATCH_MODEL=anthropic/claude-3.5-sonnet
#TARGET_MODEL=anthropic/claude-3.5-sonnet
#ENV_MODEL=anthropic/claude-3.5-sonnet
#JUDGE_MODEL=anthropic/claude-3.5-sonnet
#TESTER_MODEL=anthropic/claude-3.5-sonnet

# LangSmith tracing (opzionale)
LANGCHAIN_API_KEY=lsv2_....
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=final_ecosystem


# Timeout (s) per singola chiamata API dell'agente DENTRO il container.
# Alzalo se il modello è lento sotto parallelismo. Propagato dal docker_runner;
# default 90 se non impostato.
#API_TIMEOUT=90
